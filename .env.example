NODE_ENV=development
PORT=3000
DATABASE_URL=

# Configure only after auditing endpoint contracts and access.
SPORTAPI_AI_KEY=
SPORTAPI_AI_BASE_URL=https://sportapi.ai/api
SPORTMONKS_API_KEY=
SPORTMONKS_BASE_URL=https://api.sportmonks.com/v3/football
THERUNDOWN_KEY=
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# Optional explanation model; deterministic analysis must work without it.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Protect on-demand provider checks in production; never expose provider keys to the browser.
PROVIDER_DIAGNOSTICS_TOKEN=
